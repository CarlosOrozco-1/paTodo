rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== Helpers =====================

    // Usuario autenticado.
    function signedIn() {
      return request.auth != null;
    }

    // El usuario tiene uno de los roles indicados.
    // El rol vive en el Custom Claim `role` del ID token (lo asigna POST /createUser).
    // Se usa get() con valor por defecto para denegar limpiamente cuando el token
    // aún no trae el claim (en vez de fallar al leer una propiedad inexistente).
    function hasRole(roles) {
      return signedIn() && request.auth.token.get('role', '') in roles;
    }

    // El usuario no está suspendido. Un admin puede suspender la cuenta de un
    // usuario (status: suspended vía POST /admin/suspendUser); la regla bloquea
    // sus escrituras. Los usuarios previos al campo status se tratan como active.
    function notSuspended() {
      return signedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                  .get('status', 'active') != 'suspended';
    }

    // El documento de entrada no excede 128 KiB (protección DoS).
    function smallEnough() {
      return request.resource.data.size() <= 131072;
    }

    // ===================== users =====================
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer los perfiles de los usuarios.
      allow read: if signedIn();

      // El usuario puede editar su perfil/contacto/ubicación/dispositivos, pero
      // nunca campos que controla la API: uid, email, role, verified, status,
      // stats, createdAt. Un usuario suspendido tampoco puede editar su perfil.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && notSuspended()
                    && smallEnough()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['profile', 'contact', 'location', 'fcmTokens',
                                  'skills', 'vehicleIds', 'availability', 'updatedAt']);

      // La creación y eliminación se manejan desde la API.
      allow create, delete: if false;
    }

    // ===================== jobs =====================
    match /jobs/{jobId} {
      // Cualquier usuario autenticado puede leer los trabajos.
      allow read: if signedIn();

      // Solo un cliente (role client/both) puede publicar un trabajo,
      // asignándose como dueño. Nace siempre en estado pending.
      allow create: if hasRole(['client', 'both'])
                    && notSuspended()
                    && smallEnough()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['clientId', 'details', 'location', 'pricing', 'status']);

      // El cliente dueño solo puede editar el contenido de su publicación.
      // Los cambios de ciclo de vida (status, workerId, acceptedOfferId, route,
      // completedAt, cancelReason) los hace la API: /acceptOffer, /cancelJob y
      // /completeJob. Así el cliente no puede autocompletar ni autocancelar un
      // trabajo saltándose las transacciones.
      allow update: if signedIn()
                    && notSuspended()
                    && smallEnough()
                    && resource.data.clientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['details', 'pricing', 'location', 'updatedAt']);

      // Solo se elimina un trabajo propio que siga pendiente (sin trabajador
      // asignado ni ofertas aceptadas). Para el resto se usa /cancelJob.
      allow delete: if signedIn()
                    && notSuspended()
                    && resource.data.clientId == request.auth.uid
                    && resource.data.status == 'pending';

      // Modelo: jobs/{jobId}/tracking/current contiene solo la ultima posicion
      // (latitude/longitude), UID del trabajador y timestamp. No es historial.
      match /tracking/{trackingId} {
        function parentJobPath() {
          return /databases/$(database)/documents/jobs/$(jobId);
        }

        function parentJobIsActive() {
          return exists(parentJobPath())
                 && get(parentJobPath()).data.status in ['accepted', 'assigned', 'in_progress'];
        }

        function isJobParticipant() {
          return signedIn()
                 && parentJobIsActive()
                 && (request.auth.uid == get(parentJobPath()).data.clientId
                     || request.auth.uid == get(parentJobPath()).data.workerId);
        }

        function isAssignedWorker() {
          return signedIn()
                 && hasRole(['worker', 'both'])
                 && parentJobIsActive()
                 && request.auth.uid == get(parentJobPath()).data.workerId;
        }

        function isValidTrackingLocation() {
          let data = request.resource.data;
          return smallEnough()
                 && data.keys().hasAll(['workerId', 'latitude', 'longitude', 'updatedAt'])
                 && data.keys().hasOnly(['workerId', 'latitude', 'longitude', 'accuracyMeters',
                                         'headingDegrees', 'speedMetersPerSecond', 'updatedAt'])
                 && data.workerId is string
                 && data.workerId == request.auth.uid
                 && data.latitude is number
                 && data.latitude >= -90
                 && data.latitude <= 90
                 && data.longitude is number
                 && data.longitude >= -180
                 && data.longitude <= 180
                 && data.updatedAt is timestamp
                 && data.updatedAt == request.time
                 && (!('accuracyMeters' in data)
                     || (data.accuracyMeters is number
                         && data.accuracyMeters >= 0
                         && data.accuracyMeters <= 10000))
                 && (!('headingDegrees' in data)
                     || (data.headingDegrees is number
                         && data.headingDegrees >= 0
                         && data.headingDegrees <= 360))
                 && (!('speedMetersPerSecond' in data)
                     || (data.speedMetersPerSecond is number
                         && data.speedMetersPerSecond >= 0
                         && data.speedMetersPerSecond <= 100));
        }

        allow read: if trackingId == 'current' && isJobParticipant();
        allow create: if trackingId == 'current'
                      && isAssignedWorker()
                      && isValidTrackingLocation();
        allow update: if trackingId == 'current'
                      && isAssignedWorker()
                      && isValidTrackingLocation()
                      && request.resource.data.workerId == resource.data.workerId;
        allow delete: if false;
      }
    }

    // ===================== calls =====================
    // Llamadas de voz entre el cliente y el trabajador de un mismo trabajo.
    // Decisión técnica en docs/llamadas-voz.md (WebRTC P2P + relay TURN, sin
    // costo por minuto y sin llamadas a números de teléfono).
    //
    // Reparto de escrituras, a propósito:
    //   - calls/{callId}          lo escribe SOLO la API (createVoiceSession /
    //                              endVoiceCall). Así nadie se fabrica historial
    //                              de llamadas ni salta las transiciones de estado.
    //   - calls/{callId}/signals  lo escriben los DOS participantes, y solo
    //                              mientras la llamada está activa. Aquí viaja el
    //                              intercambio WebRTC (offer/answer/ICE), que es
    //                              efímero y la API borra al cerrar la llamada.
    // El audio nunca pasa por Firestore.
    match /calls/{callId} {
      function callPath() {
        return /databases/$(database)/documents/calls/$(callId);
      }

      function jobPath() {
        // Ojo: callPath() es una ruta, no un documento. Para leer el jobId hay
        // que pasar por get(); escribir callPath().data construiria la ruta
        // /jobs/undefined y negaria toda la senalizacion sin motivo apparent.
        return /databases/$(database)/documents/jobs/$(get(callPath()).data.jobId);
      }

      // Cualquier helper que use jobPath() debe comprobar antes exists(callPath()):
      // desreferenciar el documento inexistente lanza un error de evaluacion (no un
      // false) y terminaria en un PERMISSION_DENIED confuso en lugar de un
      // rechazo limpio.
      function callExists() {
        return exists(callPath());
      }

      // El trabajo debe seguir vigente: no se llama a un trabajo cancelado,
      // pendiente o ya completado.
      function jobIsActive() {
        return callExists()
               && exists(jobPath())
               && get(jobPath()).data.status in ['accepted', 'assigned', 'in_progress'];
      }

      // Solo las dos partes del trabajo pueden ver la llamada.
      function isCallParticipant() {
        return signedIn()
               && callExists()
               && (request.auth.uid == get(callPath()).data.callerId
                   || request.auth.uid == get(callPath()).data.calleeId);
      }

      // La llamada está activa o a punto de empezar: solo en estos estados tiene
      // sentido señalizar. Al cerrarse, la API borra signals.
      function callIsLive() {
        return callExists()
               && get(callPath()).data.status in ['ringing', 'in_progress'];
      }

      allow read: if signedIn() && notSuspended() && isCallParticipant();

      // Crear, modificar y borrar el registro es responsabilidad exclusiva de
      // la API REST: la autorización, las transiciones válidas y el borrado de
      // la señalización ocurren allí, no aquí.
      allow create, update, delete: if false;

      // ---- Señalización WebRTC (efímera) ----
      match /signals/{signalId} {
        // offer/answer/cancel llevan la descripción de sesión; ice lleva un
        // candidato. El límite de 16 KiB cubre un SDP largo y frena de paso
        // que alguien use esta ruta para escribir basura.
        function isValidSignal() {
          let data = request.resource.data;
          return smallEnough()
                 && data.keys().hasAll(['from', 'type', 'payload', 'createdAt'])
                 && data.keys().hasOnly(['from', 'type', 'payload', 'createdAt'])
                 && data.from is string
                 && data.from == request.auth.uid
                 && data.type in ['offer', 'answer', 'ice', 'cancel']
                 && data.payload is string
                 && data.payload.size() > 0
                 && data.payload.size() <= 16384
                 && data.createdAt is timestamp
                 && data.createdAt == request.time;
        }

        allow read: if signedIn() && notSuspended() && isCallParticipant();

        // Solo se agrega: los mensajes de señalización no se editan ni se
        // borran desde el cliente (los borra la API al cerrar la llamada).
        // `from` debe ser el propio UID, así que un cliente no puede enviar
        // señalización en nombre del otro.
        allow create: if signedIn()
                      && notSuspended()
                      && jobIsActive()
                      && callIsLive()
                      && isCallParticipant()
                      && isValidSignal();

        allow update, delete: if false;
      }
    }

    // ===================== callLocks =====================
    // Exclusion mutua por trabajo, para que dos peticiones simultaneas de
    // /createVoiceSession no creen dos llamadas (doble tap en "Llamar").
    //
    // Aqui hay un documento por trabajo cuyo unico campo es el callId de la
    // llamada viva. La API lo toma dentro de una transaccion: por eso dos
    // peticiones a la vez se serializan en vez de colarse.
    //
    // NO es un documento de negocio: no se lista, no se exporta y no aparece en
    // el historial. Los clientes no lo necesitan en absoluto.
    //
    // Nota sobre la seguridad: Firestore ya deniega por defecto todo lo que no
    // esta en un `match`, asi que esta regla es explicita por legibilidad del
    // ruleset, no necesaria. Si se borra, los clientes siguen sin poder tocarla.
    match /callLocks/{jobId} {
      allow read, write: if false;
    }

    // ===================== offers =====================
    match /offers/{offerId} {
      // El trabajador que creó la oferta puede leerla.
      // El cliente dueño del trabajo también puede leer las ofertas de ese trabajo.
      allow read: if signedIn()
                  && (resource.data.workerId == request.auth.uid
                      || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.clientId == request.auth.uid);

      // Solo un trabajador (role worker/both) puede ofertar un trabajo ajeno que
      // siga pendiente. Nace siempre en estado pending y con los campos mínimos.
      allow create: if hasRole(['worker', 'both'])
                    && notSuspended()
                    && smallEnough()
                    && request.resource.data.workerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['jobId', 'workerId', 'price', 'estimatedTime', 'status'])
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.clientId != request.auth.uid
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'pending';

      // El trabajador dueño puede ajustar su propuesta o retirarla
      // (pending -> withdrawn). No puede auto-aceptarse la oferta (eso lo hace
      // el cliente vía /acceptOffer) ni cambiar a qué trabajo pertenece.
      allow update: if signedIn()
                    && notSuspended()
                    && smallEnough()
                    && resource.data.workerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['price', 'message', 'estimatedTime', 'currency', 'status', 'updatedAt'])
                    && (request.resource.data.status == resource.data.status
                        || (resource.data.status == 'pending'
                            && request.resource.data.status == 'withdrawn'));

      // Eliminar ofertas solo desde la API.
      allow delete: if false;
    }

    // ===================== skills =====================
    match /skills/{skillId} {
      // Cualquiera puede leer el catálogo de habilidades.
      allow read: if true;

      // Solo el rol admin (super usuario) mantiene el catálogo: crea, edita o
      // desactiva habilidades. Los seed scripts usan el Admin SDK (ignoran reglas).
      allow create, update, delete: if hasRole(['admin']) && smallEnough();
    }

    // ===================== categories =====================
    match /categories/{categoryId} {
      // Cualquiera puede leer el catálogo de categorías.
      allow read: if true;

      // Solo el rol admin (super usuario) mantiene el catálogo: crea, edita o
      // desactiva categorías. Los seed scripts usan el Admin SDK (ignoran reglas).
      allow create, update, delete: if hasRole(['admin']) && smallEnough();
    }

    // ===================== vehicles =====================
    match /vehicles/{vehicleId} {
      // Cualquier usuario autenticado puede leer los vehículos.
      allow read: if signedIn();

      // Solo el trabajador dueño puede crear un vehículo, asignándose como ownerId.
      allow create: if hasRole(['worker', 'both'])
                    && notSuspended()
                    && smallEnough()
                    && request.resource.data.ownerId == request.auth.uid;

      // Solo el dueño puede actualizar o eliminar su vehículo.
      allow update, delete: if signedIn()
                            && notSuspended()
                            && smallEnough()
                            && resource.data.ownerId == request.auth.uid;
    }

    // ===================== reviews =====================
    match /reviews/{reviewId} {
      // Cualquier usuario autenticado puede leer las reseñas.
      allow read: if signedIn();

      // Las reseñas son transaccionales: solo se crean desde la API (POST /createReview),
      // que valida autor, trabajo completado, 1 reseña por trabajo y recalcula stats.
      allow create, update, delete: if false;
    }

    // ===================== payments =====================
    match /payments/{paymentId} {
      // Solo el cliente que pagó o el trabajador cobrador pueden leer el pago.
      allow read: if signedIn()
                  && (resource.data.clientId == request.auth.uid
                      || resource.data.workerId == request.auth.uid);

      // Los pagos son transaccionales y de la API (POST /createPayment), que
      // valida al dueño del trabajo, calcula comisión y escribe job.payment.
      // El módulo es demo (isDemo: true), sin dinero real.
      allow create, update, delete: if false;
    }

    // ===================== activity =====================
    match /activity/{activityId} {
      // Solo el rol admin puede leer el log de actividad (dashboard).
      allow read: if hasRole(['admin']);
      // El log lo escribe exclusivamente la API (Admin SDK ignora estas reglas).
      allow write: if false;
    }

    // ===================== notifications =====================
    match /notifications/{notificationId} {
      // Solo el usuario destinatario puede leer sus notificaciones.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Los destinatarios solo pueden marcarlas como leídas (readAt/updatedAt).
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && smallEnough()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['readAt', 'updatedAt']);

      // Las notificaciones se crean desde la API.
      allow create, delete: if false;
    }

    // ===================== conversations =====================
    match /conversations/{conversationId} {
      // Solo los participantes de la conversación pueden leerla.
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // La conversación se crea desde la API al aceptar una oferta.
      allow create: if false;

      // Los participantes solo pueden tocar lastMessage/lastReadAt; la identidad,
      // el estado y el snapshot los controla la API.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && smallEnough()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'lastReadAt', 'updatedAt']);

      // No se eliminan desde el cliente.
      allow delete: if false;

      // Subcolección messages
      match /messages/{messageId} {
        // Solo los participantes de la conversación pueden leer los mensajes.
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Solo los participantes pueden crear mensajes, asignándose como senderId.
        allow create: if signedIn()
                      && smallEnough()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;

        // Los mensajes no se editan ni se eliminan.
        allow update, delete: if false;
      }
    }
  }
}
