# Copia este archivo a .env y completa los valores.

# Nombre de la aplicación.
VITE_APP_NAME=PaTodo

# Modo de operación:
# demo: usa datos simulados en localStorage (no necesita backend).
# real: conecta con Firebase + API REST (requiere VITE_API_URL y VITE_FIREBASE_*).
# auto: prueba el health check de la API al arrancar y cae a demo si no responde.
VITE_API_MODE=real

# URL base de la API REST (transacciones).
VITE_API_URL=https://patodo.onrender.com

# Configuración de Firebase (proyecto `pa-todo`, producción).
VITE_FIREBASE_API_KEY=AIzaSyBm2-3lFSDowZxcG_I3jmm-Ua2MqECZwKw
VITE_FIREBASE_AUTH_DOMAIN=pa-todo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pa-todo
VITE_FIREBASE_STORAGE_BUCKET=pa-todo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=377828600122
VITE_FIREBASE_APP_ID=1:377828600122:web:10240133e36a4043cac803
VITE_FIREBASE_MEASUREMENT_ID=G-QBMDSDDNGH

# Opcional: true para usar los emuladores locales de Firebase
# (auth en 127.0.0.1:9099 y firestore en 127.0.0.1:8081).
VITE_FIREBASE_EMULATOR=false

# Token público de Mapbox (requerido para el mapa). Reemplaza por tu token de Mapbox (NO subir tokens reales).
VITE_MAPBOX_TOKEN=pk.TU_TOKEN_PUBLICO_AQUI

# Client ID de Google OAuth (inicio de sesión con Google). Default: el del proyecto.
VITE_GOOGLE_CLIENT_ID=377828600122-r6kc7b5surfos5ha27fbs4lb9ue7672t.apps.googleusercontent.com

# Rutas con # (hash router). Solo necesario en true para el build portable
# (npm run build:portable usa .env.portable). En desarrollo dejar ausente/false.
VITE_HASH_ROUTER=false