# ===== PaTodo: Configuración del frontend web =====
# Copia este archivo a `.env` y ajusta según el entorno.
#
# Producción: deja USE_EMULATORS en false. La API vive en Render, Firebase real.
# Desarrollo: levanta los emuladores (auth 9099, firestore 8081) y la API local.

VITE_API_URL=http://127.0.0.1:3000

# true = usar emuladores de Firebase locales; false = Firebase real (producción)
VITE_USE_EMULATORS=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8081

