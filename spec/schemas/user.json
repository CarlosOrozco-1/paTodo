{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "role": {
      "type": "string",
      "enum": ["client", "worker", "both"],
      "description": "Rol del usuario en la plataforma"
    },
    "skillIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
      "description": "Referencias a skills del trabajador (ObjectId de skills)"
    },
    "account": {
      "type": "object",
      "description": "Datos de cuenta y autenticación (INTERNO - no exponer en API pública)",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "passwordHash": { "type": "string" },
        "verified": { "type": "boolean", "default": false },
        "lastLogin": { "type": "string", "format": "date-time" },
        "loginAttempts": { "type": "integer", "default": 0 },
        "lockUntil": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["email", "passwordHash"]
    },
    "profile": {
      "type": "object",
      "description": "Información personal pública",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other", "prefer_not_to_say"] },
        "birthdate": { "type": "string", "format": "date" }
      },
      "required": ["firstName", "lastName"]
    },
    "contact": {
      "type": "object",
      "description": "Datos de contacto",
      "properties": {
        "phone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zip": { "type": "string" },
            "country": { "type": "string", "default": "GT" }
          }
        }
      },
      "required": ["phone"]
    },
    "location": {
      "type": ["object", "null"],
      "description": "Ubicación actual (GeoJSON Point) - opcional",
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[longitud, latitud]"
        }
      },
      "required": ["type", "coordinates"]
    },
    "stats": {
      "type": "object",
      "description": "Métricas y reputación",
      "properties": {
        "rating": { "type": "number", "minimum": 0, "maximum": 5, "default": 0 },
        "ratingCount": { "type": "integer", "minimum": 0, "default": 0 },
        "completedJobs": { "type": "integer", "minimum": 0, "default": 0 },
        "cancelledJobs": { "type": "integer", "minimum": 0, "default": 0 },
        "responseTimeMin": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "availability": {
      "type": "object",
      "description": "Disponibilidad y horario",
      "properties": {
        "isOnline": { "type": "boolean", "default": false },
        "workingHours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
              "start": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" }
            },
            "required": ["day", "start", "end"]
          }
        },
        "serviceArea": {
          "type": "object",
          "description": "Área de servicio centrada en location del usuario",
          "properties": {
            "center": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["Point"] },
                "coordinates": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": ["type", "coordinates"]
            },
            "radiusKm": { "type": "number", "minimum": 0, "default": 10 }
          },
          "required": ["radiusKm"]
        }
      }
    },
    "vehicleIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
      "description": "Referencias a la colección vehicles (ObjectId)"
    },
    "notificationSettings": {
      "type": "object",
      "description": "Preferencias de notificación por canal y tipo",
      "properties": {
        "push": { "type": "boolean", "default": true },
        "email": { "type": "boolean", "default": true },
        "sms": { "type": "boolean", "default": false },
        "inApp": { "type": "boolean", "default": true },
        "types": {
          "type": "object",
          "description": "Configuración granular por tipo de notificación",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "push": { "type": "boolean" },
              "email": { "type": "boolean" },
              "sms": { "type": "boolean" },
              "inApp": { "type": "boolean" }
            }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["role", "account", "profile", "contact"],
  "additionalProperties": true
}