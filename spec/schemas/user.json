{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)"
    },
    "role": {
      "type": "string",
      "enum": ["client", "worker", "both"],
      "description": "Rol del usuario en la plataforma"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Habilidades del trabajador (ej: plomeria, cambio_llantas)"
    },
    "account": {
      "type": "object",
      "description": "Datos de cuenta y autenticación",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "passwordHash": { "type": "string" },
        "verified": { "type": "boolean" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "passwordHash"]
    },
    "profile": {
      "type": "object",
      "description": "Información personal pública",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "birthdate": { "type": "string", "format": "date" }
      },
      "required": ["firstName", "lastName"]
    },
    "contact": {
      "type": "object",
      "description": "Datos de contacto",
      "properties": {
        "phone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "city": { "type": "string" },
            "zip": { "type": "string" }
          }
        }
      },
      "required": ["phone"]
    },
    "location": {
      "type": "object",
      "description": "Ubicación actual (GeoJSON Point)",
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[longitud, latitud]"
        }
      },
      "required": ["type", "coordinates"]
    },
    "stats": {
      "type": "object",
      "description": "Métricas y reputación",
      "properties": {
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "ratingCount": { "type": "integer", "minimum": 0 },
        "completedJobs": { "type": "integer", "minimum": 0 },
        "cancelledJobs": { "type": "integer", "minimum": 0 },
        "responseTimeMin": { "type": "integer", "minimum": 0 }
      }
    },
    "availability": {
      "type": "object",
      "description": "Disponibilidad y horario",
      "properties": {
        "isOnline": { "type": "boolean" },
        "workingHours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": { "type": "string" },
              "start": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" }
            },
            "required": ["day", "start", "end"]
          }
        },
        "serviceArea": {
          "type": "object",
          "properties": {
            "radiusKm": { "type": "number", "minimum": 0 }
          },
          "required": ["radiusKm"]
        }
      }
    },
    "vehicleIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Referencias a la colección vehicles"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["role", "account", "profile", "contact"],
  "additionalProperties": true
}
