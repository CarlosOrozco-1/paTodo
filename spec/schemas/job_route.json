{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobRoute",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Trabajo asociado a la ruta (ObjectId de jobs)"
    },
    "type": {
      "type": "string",
      "enum": ["worker_to_job", "client_to_job", "worker_to_client"],
      "description": "Tipo de ruta: trabajador→trabajo, cliente→trabajo, trabajador→cliente"
    },
    "geometry": {
      "type": "object",
      "description": "Geometría de la ruta en formato GeoJSON LineString",
      "properties": {
        "type": { "type": "string", "enum": ["LineString"] },
        "coordinates": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "minItems": 2,
          "description": "Lista de puntos [longitud, latitud] que forman la ruta"
        }
      },
      "required": ["type", "coordinates"]
    },
    "polyline": {
      "type": ["string", "null"],
      "description": "Polyline encoded (Google/OSRM) para renderizado eficiente en frontend"
    },
    "distance": {
      "type": "number",
      "minimum": 0,
      "description": "Distancia total de la ruta en metros"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "description": "Duración estimada en segundos"
    },
    "source": {
      "type": "string",
      "description": "Origen de la ruta (ej: osrm, google, mapbox, manual)"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["Point"] },
          "coordinates": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "name": { "type": "string" }
        }
      },
      "description": "Puntos intermedios de la ruta"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Fecha de expiración opcional para invalidar rutas antiguas"
    }
  },
  "required": ["jobId", "type", "geometry", "distance", "duration", "source"],
  "additionalProperties": true
}