{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Trabajo al que pertenece el mensaje (ObjectId de jobs)"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Referencia a conversación (ObjectId de conversations)"
    },
    "senderId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Usuario que envía el mensaje (ObjectId de users)"
    },
    "receiverId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Usuario que recibe el mensaje (ObjectId de users)"
    },
    "type": {
      "type": "string",
      "enum": ["text", "image", "location", "system", "file", "voice"],
      "default": "text",
      "description": "Tipo de contenido del mensaje"
    },
    "content": {
      "type": "string",
      "description": "Contenido del mensaje (texto, URL de imagen/archivo, JSON de ubicación)"
    },
    "metadata": {
      "type": "object",
      "description": "Metadatos según tipo",
      "properties": {
        "fileName": { "type": "string" },
        "fileSize": { "type": "integer" },
        "mimeType": { "type": "string" },
        "duration": { "type": "integer", "description": "Duración en segundos para voice" },
        "location": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["Point"] },
            "coordinates": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "replyTo": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Mensaje al que responde (ObjectId de messages)"
    },
    "readAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Fecha de lectura por el receptor"
    },
    "deliveredAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Fecha de entrega al dispositivo del receptor"
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["jobId", "conversationId", "senderId", "receiverId", "content"],
  "additionalProperties": true
}