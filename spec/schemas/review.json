{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Trabajo al que pertenece la reseña (ObjectId de jobs con status completed)"
    },
    "reviewerId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Usuario que califica (ObjectId de users)"
    },
    "revieweeId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Usuario que es calificado (ObjectId de users)"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Puntuación de 1 a 5 estrellas"
    },
    "comment": {
      "type": "string",
      "description": "Comentario opcional sobre el servicio"
    },
    "aspects": {
      "type": "object",
      "description": "Calificaciones por aspecto (opcional)",
      "properties": {
        "quality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "punctuality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "communication": { "type": "integer", "minimum": 1, "maximum": 5 },
        "value": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "isPublic": {
      "type": "boolean",
      "default": true,
      "description": "Si la reseña es visible públicamente"
    },
    "response": {
      "type": ["object", "null"],
      "description": "Respuesta del reviewee a la reseña",
      "properties": {
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["jobId", "reviewerId", "revieweeId", "rating"],
  "additionalProperties": true
}