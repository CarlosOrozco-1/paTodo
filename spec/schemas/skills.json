{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "description": "Nombre legible de la habilidad (ej: Cambio de llantas)"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Identificador único para la habilidad (ej: cambio_llantas)"
    },
    "description": {
      "type": "string",
      "description": "Descripción detallada de la habilidad"
    },
    "icon": {
      "type": "string",
      "description": "Nombre del icono (ej: lucide:wrench, material:build) o URL"
    },
    "categoryIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Categorías donde aplica esta habilidad (ObjectId de categories)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Si la habilidad está disponible para selección"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de creación"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de última actualización"
    }
  },
  "required": ["name", "slug"],
  "additionalProperties": true
}