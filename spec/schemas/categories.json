{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Category",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "description": "Nombre de la categoría (ej: Mecánica, Plomería)"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identificador único para la categoría (ej: mecanica, plomeria)"
    },
    "description": {
      "type": "string",
      "description": "Descripción detallada de la categoría"
    },
    "icon": {
      "type": "string",
      "description": "Nombre del icono (ej: lucide:car, material:plumbing) o URL"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "Color hex para UI (ej: #3B82F6)"
    },
    "imageUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL de imagen/banner representativa"
    },
    "parentId": {
      "type": ["string", "null"],
      "description": "Referencia a categoría padre (ObjectId), null si es raíz"
    },
    "skillIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Referencias a skills (ObjectId de skills)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Si la categoría está disponible para uso"
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Orden de visualización en listados"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de creación"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de última actualización"
    }
  },
  "required": ["name", "slug"],
  "additionalProperties": true
}