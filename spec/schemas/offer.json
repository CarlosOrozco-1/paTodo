{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offer",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "Identificador único (ObjectId en MongoDB)",
      "readOnly": true
    },
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Referencia al trabajo (ObjectId de jobs)"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Referencia al trabajador que oferta (ObjectId de users)"
    },
    "workerSnapshot": {
      "type": "object",
      "description": "Resumen del trabajador en el momento de la oferta (denormalizado)",
      "properties": {
        "name": { "type": "string", "description": "Nombre completo del trabajador" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "completedJobs": { "type": "integer", "minimum": 0 },
        "avatarUrl": { "type": "string", "format": "uri" }
      },
      "required": ["name", "rating"]
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Precio ofertado por el trabajador"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "GTQ",
      "description": "Moneda ISO 4217"
    },
    "estimatedTime": {
      "type": "integer",
      "minimum": 0,
      "description": "Tiempo estimado en minutos"
    },
    "message": {
      "type": "string",
      "description": "Nota opcional del trabajador"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected", "withdrawn", "expired"],
      "description": "Estado de la oferta"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Fecha de expiración automática de la oferta"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["jobId", "workerId", "price", "estimatedTime", "status"],
  "additionalProperties": true
}