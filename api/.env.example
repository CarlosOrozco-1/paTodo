# URL base del servidor (Render lo asigna automáticamente)
PORT=3000

# Credencial de servicio de Firebase (JSON en base64)
# Solo se usa en producción. En local, con emuladores, no es necesaria.
FIREBASE_SERVICE_ACCOUNT=

# Emuladores (solo para desarrollo local)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
