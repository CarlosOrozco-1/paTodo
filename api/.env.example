# URL base del servidor (Render lo asigna automáticamente)
PORT=3000

# Credencial de servicio de Firebase (JSON en base64)
# Solo se usa en producción. En local, con emuladores, no es necesaria.
FIREBASE_SERVICE_ACCOUNT=

# Emuladores (solo para desarrollo local)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Primer administrador (bootstrap con `npm run create-admin`).
# El rol admin NO es autoasignable por registro; nace solo con este script.
# Con valores por defecto usa admin@test.com / Testing123 (solo desarrollo).
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Testing123

# ===================== Llamadas de voz (WebRTC) =====================
# Ver docs/llamadas-voz.md. Todas son opcionales: sin ellas la API funciona en
# modo solo STUN y las llamadas conectan siempre que haya ruta directa.
# Render se configura con estas mismas variables.

# STUN: solo descubre la dirección pública, no retransmite audio.
# Si se deja vacío se usan los STUN públicos de Google.
STUN_URLS=

# TURN: retransmite el audio cuando no hay ruta directa (CGNAT). Fase IV.
# Varias URLs separadas por coma, con su puerto.
TURN_URLS=

# Secreto compartido con coturn (`use-auth-secret`). OBLIGATORIO si hay TURN_URLS.
# NUNCA va en el bundle del frontend, ni en Firestore, ni en spec/.
# Rotar el secreto invalida las credenciales en curso: es aceptable.
TURN_SECRET=

# Vida de la credencial TURN firmada, en segundos. Corta a propósito.
TURN_TTL_SECONDS=3600

# Segundos tras los que una llamada en "ringing" se considera abandonada y se
# cierra sola como "missed". Sin tono de ring en el v1, el "ringing" no expira
# por sí solo y bloquearía con 409 las llamadas siguientes.
RINGING_TIMEOUT_MS=120000
