# Copia este archivo como `.env` y rellena con tus valores reales.
# `.env` está en .gitignore: NUNCA se versiona. Este template sí se comparte.

# URI de MongoDB Atlas con la base en el path (obligatorio: /paTodo)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.r1esj8j.mongodb.net/paTodo?appName=Cluster0

# Clave de firma JWT (min. 256 bits). Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Puerto HTTP. Usar 8081 en este equipo (8080 ocupado)
SERVER_PORT=8081

# Orígenes CORS y WebSocket permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8080
WS_ORIGINS=http://localhost:3000,http://localhost:5173