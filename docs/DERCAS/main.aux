\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Diagrama entidad-relación de PaTodo (modelo de documentos en Cloud Firestore). Los nombres de las entidades corresponden a las colecciones y los campos a los atributos principales; las relaciones indican referencias por identificador que las reglas de seguridad y la API mantienen consistentes (Firestore no impone claves foráneas). \texttt  {messages} es subcolección de \texttt  {conversations} y \texttt  {tracking} (documento único \texttt  {current}) de \texttt  {jobs}.}}{60}{figure.caption.29}\protected@file@percent }
\newlabel{fig:er}{{28}{60}{Diagrama entidad-relación de PaTodo (modelo de documentos en Cloud Firestore). Los nombres de las entidades corresponden a las colecciones y los campos a los atributos principales; las relaciones indican referencias por identificador que las reglas de seguridad y la API mantienen consistentes (Firestore no impone claves foráneas). \texttt {messages} es subcolección de \texttt {conversations} y \texttt {tracking} (documento único \texttt {current}) de \texttt {jobs}}{figure.caption.29}{}}
