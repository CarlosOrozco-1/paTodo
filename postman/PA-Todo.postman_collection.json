    {
      "name": "Jobs (requieren token)",
      "description": "Solicitudes autenticadas. El token se agrega automáticamente vía la autorización de la colección.",
      "item": [
        {
          "name": "POST /jobs",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"details\": {\n    \"title\": \"Cambio de batería\",\n    \"description\": \"La batería del carro no da marcha, necesito cambio a domicilio.\",\n    \"categoryId\": \"6a9b68a938f191673bfe1323\",\n    \"skillIds\": [\"6a9ce21f439c91b39662c834\"]\n  },\n  \"location\": {\n    \"coordinates\": [-90.5069, 14.6349],\n    \"address\": \"Zona 10, Ciudad de Guatemala\",\n    \"placeId\": \"ChIJjUCr2UArYI8RDt1gdRpXxlM\"\n  },\n  \"pricing\": {\n    \"proposedPrice\": 250,\n    \"currency\": \"GTQ\",\n    \"priceType\": \"fixed\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job creado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"jobId\", json.id);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /jobs (lista paginada)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?status=&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "status", "value": "", "disabled": true },
                { "key": "categoryId", "value": "", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Listado de jobs\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    if (json.content && json.content.length > 0) {",
                  "        pm.collectionVariables.set(\"jobId\", json.content[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
